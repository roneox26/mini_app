# ============================================
# Telegram Mining App — Environment Variables
# ============================================

# Flask
FLASK_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=true

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=YourBotUsername

# Database (PostgreSQL)
DATABASE_URL=postgresql://mininguser:miningpassword@localhost:5432/miningdb
# For Docker use: postgresql://mininguser:miningpassword@postgres:5432/miningdb

# Redis
REDIS_URL=redis://localhost:6379/0
# For Docker use: redis://redis:6379/0

# Security
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_EXPIRY_HOURS=24

# Monetag
MONETAG_PUBLISHER_ID=your_monetag_publisher_id
MONETAG_ZONE_ID_REWARDED=your_rewarded_zone_id
MONETAG_ZONE_ID_POPUP=your_popup_zone_id
MONETAG_SECRET_KEY=your_monetag_secret_key

# Admin Panel
ADMIN_SECRET_KEY=your-admin-secret-key
FIRST_ADMIN_TELEGRAM_ID=your_telegram_user_id

# Mining Configuration
DEFAULT_MINING_RATE=10          # coins per hour for free users
MINING_SESSION_HOURS=8          # max mining window in hours
AD_REWARD_COINS=100             # coins per completed ad
AD_COOLDOWN_MINUTES=5           # cooldown between ads
AD_DAILY_LIMIT=10               # max ads per user per day
REFERRAL_REWARD_COINS=500       # total referral reward
MIN_WITHDRAWAL_COINS=1000000    # 1,000,000 coins minimum
WITHDRAWAL_FEE_PERCENT=5        # 5% withdrawal fee

# CORS
FRONTEND_URL=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://t.me
